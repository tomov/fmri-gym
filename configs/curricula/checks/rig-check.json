{
  "curriculum": [
    {
      "type": "message",
      "text": [
        "Rig check",
        "",
        "Photodiode on the patch, bottom-right; microphone at the ear if there is one.",
        "The controls check will ask for each button: press it on the participant's device.",
        "",
        "(press [SPACE] to start)"
      ]
    },
    {
      "type": "check_display",
      "n": 60
    },
    {
      "type": "check_frames",
      "rates": [
        60,
        30
      ],
      "seconds": 2,
      "loads": [
        "none"
      ]
    },
    {
      "type": "check_triggers",
      "pulses": 3,
      "repeat": 1,
      "hold_ms": 40,
      "gap_ms": 40
    },
    {
      "type": "check_controls",
      "timeout_s": 10.0
    },
    {
      "type": "check_photodiode",
      "n": 10,
      "on_ms": 50,
      "gap_min_ms": 150,
      "gap_max_ms": 250,
      "settle_ms": 300
    }
  ]
}
